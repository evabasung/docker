FROM eclipse-temurin:21-jdk

LABEL maintainer="basung@gmail.com"

# Create Tomcat directory
RUN mkdir -p /opt/tomcat

WORKDIR /opt/tomcat

# Download Tomcat
ADD https://downloads.apache.org/tomcat/tomcat-9/v9.0.117/bin/apache-tomcat-9.0.117.tar.gz .

# Extract and move into place
RUN tar xvf apache-tomcat-9.0.117.tar.gz && \
    mv apache-tomcat-9.0.117/* /opt/tomcat/ && \
    rm -rf apache-tomcat-9.0.117 apache-tomcat-9.0.117.tar.gz

# Verify Java
RUN java -version

WORKDIR /opt/tomcat/webapps

EXPOSE 8080

CMD ["/opt/tomcat/bin/catalina.sh", "run"]
